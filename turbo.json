{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "PUBLIC_BASE_URL",
    "WEB_BASE_URL",
    "COOKIE_SECURE",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "SAMSKARA_API_URL",
    "VITE_API_BASE_URL",
    "SAMSKARA_E2E_ADMIN_URL",
    "E2E_API_PORT",
    "E2E_WEB_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "passThroughEnv": ["TMPDIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:verify": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
