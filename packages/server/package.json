{
  "name": "@samskara/server",
  "version": "0.2.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed:org": "tsx --env-file=../../.env src/scripts/seed-org.ts",
    "wt:setup": "tsx src/scripts/worktree-env.ts",
    "wt:teardown": "tsx src/scripts/worktree-env.ts --drop",
    "db:migrate:schema": "drizzle-kit migrate",
    "db:verify": "tsx src/scripts/migrate.ts --verify",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "seed:capture": "tsx --env-file=../../.env src/scripts/seed.ts --capture"
  },
  "dependencies": {
    "@hono/node-server": "1.13.8",
    "@hono/zod-validator": "0.7.6",
    "@samskara/core": "workspace:*",
    "drizzle-orm": "0.39.1",
    "hono": "4.13.4",
    "jose": "^6.2.4",
    "pino": "^9",
    "postgres": "3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.18.0",
    "drizzle-kit": "0.30.4",
    "testcontainers": "10.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
