{
  "name": "@samskara/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:org": "tsx --env-file=../../.env src/scripts/seed-org.ts",
    "db:index-search": "tsx --env-file=../../.env src/scripts/create-search-indexes.ts",
    "db:verify-search-indexes": "tsx --env-file=../../.env src/scripts/create-search-indexes.ts --verify",
    "db:drop-stale-search-indexes": "tsx --env-file=../../.env src/scripts/create-search-indexes.ts --drop-stale",
    "seed:dev": "tsx --env-file=../../.env src/scripts/seed-dev.ts",
    "wt:setup": "tsx src/scripts/worktree-env.ts",
    "wt:teardown": "tsx src/scripts/worktree-env.ts --drop",
    "seed:user": "tsx --env-file=../../.env src/scripts/seed-dev.ts --add-user"
  },
  "dependencies": {
    "@hono/node-server": "1.13.8",
    "@hono/zod-validator": "0.7.6",
    "@samskara/core": "workspace:*",
    "drizzle-orm": "0.39.1",
    "hono": "4.13.4",
    "jose": "^6.2.4",
    "pino": "^9",
    "postgres": "3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.18.0",
    "drizzle-kit": "0.30.4",
    "testcontainers": "10.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
