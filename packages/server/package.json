{
  "name": "@samskara/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:search-index": "tsx src/scripts/create-search-indexes.ts",
    "seed:org": "tsx src/scripts/seed-org.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.13.8",
    "@hono/zod-validator": "0.7.6",
    "@samskara/core": "workspace:*",
    "drizzle-orm": "0.39.1",
    "hono": "4.7.0",
    "jose": "^6.2.4",
    "pino": "^9",
    "postgres": "3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.18.0",
    "drizzle-kit": "0.30.4",
    "testcontainers": "10.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
