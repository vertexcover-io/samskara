  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.18.0",
    "drizzle-kit": "0.30.4",
    "testcontainers": "10.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
