{
  "name": "samskara",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.19",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:core": "turbo run test --filter=@samskara/core",
    "test:server": "turbo run test --filter=@samskara/server",
    "test:cli": "turbo run test --filter=@samskara/cli",
    "test:web": "turbo run test --filter=@samskara/web",
    "test:claude-session": "bun run scripts/claude-session-coverage.ts",
    "cli": "bun packages/cli/src/index.ts",
    "e2e": "bun run e2e/run.ts",
    "e2e:ui": "bun run e2e/run.ts --ui",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json",
    "lint": "biome check . && bun run lint:db",
    "lint:db": "bun run --cwd packages/server lint:db",
    "format": "biome format --write .",
    "db:generate": "bun run --cwd packages/server db:generate",
    "db:migrate": "bun run --cwd packages/server db:migrate",
    "seed:org": "bun run --cwd packages/server seed:org",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "db:index-search": "bun run --cwd packages/server db:index-search",
    "db:verify-search-indexes": "bun run --cwd packages/server db:verify-search-indexes",
    "db:drop-stale-search-indexes": "bun run --cwd packages/server db:drop-stale-search-indexes"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.62.0",
    "@types/node": "22.13.1",
    "turbo": "2.5.5",
    "typescript": "5.7.3"
  }
}
