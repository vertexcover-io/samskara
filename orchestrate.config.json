{
  "stages": {
    "worktree": {
      "skill": "create-worktree",
      "note": "Project override. Do not use harness using-git-worktrees: it symlinks .env, which puts every branch back on the shared samskara database. create-worktree drives `wt`, whose .config/wt.toml hooks give each branch its own database and port pair."
    }
  },
  "environments": {
    "default": "local",
    "local": {
      "stack_up": "docker compose -p samskara up -d --wait",
      "stack_status": "docker compose -p samskara ps",
      "stack_down": "docker compose -p samskara down",
      "migrate": "bun run db:migrate",
      "seed": "bun run seed:dev && bun run seed:org {ORG}",
      "app_up": "bash -c 'PORT=3100 bun run --cwd packages/server dev & WEB_PORT=8100 API_PROXY_TARGET=http://localhost:3100 bun run --cwd packages/web dev'",
      "app_health": "curl -sf http://localhost:3100/health",
      "stack_urls": "echo web=http://localhost:8100 api=http://localhost:3100 db=postgres://samskara:samskara@localhost:5433/samskara"
    }
  },
  "commands": {
    "bootstrap": "bun install",
    "typecheck": "bun run typecheck",
    "lint": "bun run lint",
    "lint_file": "bunx biome check {FILE}",
    "build": "bun run build",
    "test_all": "bun run test",
    "e2e": "bun run e2e"
  },
  "packages": {
    "core": {
      "path": "packages/core",
      "runner": "vitest",
      "commands": {
        "bootstrap": "bun install",
        "typecheck": "bun run --cwd packages/core typecheck",
        "lint": "bunx biome check packages/core",
        "lint_file": "bunx biome check {FILE}",
        "build": "bun run --cwd packages/core build",
        "test_all": "bun run --cwd packages/core test",
        "test_file": "bun run --cwd packages/core test {FILE}"
      }
    },
    "server": {
      "path": "packages/server",
      "runner": "vitest",
      "commands": {
        "bootstrap": "bun install",
        "typecheck": "bun run --cwd packages/server typecheck",
        "lint": "bunx biome check packages/server",
        "lint_file": "bunx biome check {FILE}",
        "build": "bun run --cwd packages/server build",
        "test_all": "bun run --cwd packages/server test",
        "test_file": "bun run --cwd packages/server test {FILE}",
        "migrate": "bun run --cwd packages/server db:migrate",
        "generate_migration": "bun run --cwd packages/server db:generate"
      }
    },
    "web": {
      "path": "packages/web",
      "runner": "vitest",
      "commands": {
        "bootstrap": "bun install",
        "typecheck": "bun run --cwd packages/web typecheck",
        "lint": "bunx biome check packages/web",
        "lint_file": "bunx biome check {FILE}",
        "build": "bun run --cwd packages/web build",
        "test_all": "bun run --cwd packages/web test",
        "test_file": "bun run --cwd packages/web test {FILE}"
      }
    },
    "cli": {
      "path": "packages/cli",
      "runner": "vitest",
      "commands": {
        "bootstrap": "bun install",
        "typecheck": "bun run --cwd packages/cli typecheck",
        "lint": "bunx biome check packages/cli",
        "lint_file": "bunx biome check {FILE}",
        "build": "bun run --cwd packages/cli build",
        "test_all": "bun run --cwd packages/cli test",
        "test_file": "bun run --cwd packages/cli test {FILE}"
      }
    }
  }
}
