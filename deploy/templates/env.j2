# Written once by deploy/deploy.py. Provisioning never overwrites this file; edit it on the
# server and `docker compose up -d app` to apply.

# Auth / GitHub OAuth. The OAuth app's callback must be
#   https://{{ domain }}/api/auth/github/callback
GITHUB_CLIENT_ID={{ client_id }}
GITHUB_CLIENT_SECRET={{ client_secret }}
PUBLIC_BASE_URL=https://{{ domain }}
COOKIE_SECURE=true
# Interface docker-compose publishes port 3000 on: 127.0.0.1 behind Caddy, 0.0.0.0 behind a
# platform proxy that forwards from outside the VM.
APP_BIND={{ app_bind }}
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN=7d
# Comma-separated GitHub logins that get full read/write access to every project.
SUPER_ADMIN_LOGINS={{ super_admins }}

# AI review. The server refuses to start unless the configured harness has a credential.
AI_REVIEW_HARNESS={{ review_harness }}
{% for key, value in review_keys.items() -%}
{{ key }}={{ value }}
{% endfor %}
# Image the Deploy workflow publishes: ghcr.io/OWNER/REPO. A fork names its own.
SAMSKARA_IMAGE={{ image }}

# Database. Postgres is reachable only inside the compose network, as `db`.
POSTGRES_PASSWORD={{ pg_password }}
DATABASE_URL=postgres://samskara:{{ pg_password }}@db:5432/samskara

LOG_LEVEL=info
