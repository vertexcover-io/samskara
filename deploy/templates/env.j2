# Seeded once by deploy/deploy.py, which never overwrites it. On every deploy,
# .github/workflows/deploy.yml merges the repo's `production` environment into this file:
# every variable and secret there replaces the key of the same name here, or is appended.
# So the way to change a setting is the repo's environment settings, then a deploy. Only the
# generated JWT_SECRET and POSTGRES_PASSWORD live solely here.

# Auth / GitHub OAuth. The OAuth app's callback must be
#   https://{{ domain }}/api/auth/github/callback
GITHUB_CLIENT_ID={{ client_id }}
GITHUB_CLIENT_SECRET={{ client_secret }}
PUBLIC_BASE_URL=https://{{ domain }}
COOKIE_SECURE=true
# Interface docker-compose publishes port 3000 on: 127.0.0.1 behind Caddy, 0.0.0.0 behind a
# platform proxy that forwards from outside the VM.
APP_BIND={{ app_bind }}
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN=7d
# Comma-separated GitHub logins that get full read/write access to every project.
SUPER_ADMIN_LOGINS={{ super_admins }}

# AI review. The server refuses to start unless the configured harness has a credential.
# claude: CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) or ANTHROPIC_API_KEY.
# opencode: OPENCODE_API_KEY. Both CLIs are in the image.
AI_REVIEW_HARNESS={{ review_harness }}
# The opencode lane's microVM (msb) needs KVM, which the container cannot reach, so opencode
# runs in-process. claude is always in-process.
AI_REVIEW_HARDEN=0
{% for key, value in review_keys.items() -%}
{{ key }}={{ value }}
{% endfor %}
# Database. Postgres is reachable only inside the compose network, as `db`.
POSTGRES_PASSWORD={{ pg_password }}
DATABASE_URL=postgres://samskara:{{ pg_password }}@db:5432/samskara

LOG_LEVEL=info
# Which image tag is running. Updated by the Deploy workflow on every deploy.
SAMSKARA_TAG={{ tag }}
