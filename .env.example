# Auth / GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated GitHub logins that get full read/write access to every project.
SUPER_ADMIN_LOGINS=
# Local dev sign-in without GitHub OAuth. Setting LOCAL_LOGIN_SECRET enables it and makes
# GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET optional. Leave it unset in any real deployment:
# whoever guesses the secret gets a full session.
# LOCAL_LOGIN_SECRET=
# LOCAL_LOGIN_LOGIN=samskara-dev

# AI review. The server refuses to start unless the configured harness has a credential.
# opencode needs OPENCODE_API_KEY; claude needs CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY.
AI_REVIEW_HARNESS=opencode
OPENCODE_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# AI_REVIEW_MODEL=
# AI_REVIEW_TIMEOUT_MS=600000
# How many claude/opencode processes the worker runs at once; each opencode sandbox takes 2 GB.
# AI_AGENT_SLOTS=4
# How many readers one review runs at once; they wait for AI_AGENT_SLOTS like every agent.
# AI_READER_CONCURRENCY=4
# Tries a review or fix run gets before it is failed for good (1 to 10).
# WORK_MAX_ATTEMPTS=3
# Projects with automatic review on get their quiet sessions queued once a night, at this time
# in this zone; each project gets at most NIGHTLY_REVIEW_LIMIT reviews a night (1 to 25).
# NIGHTLY_REVIEW_TIME=01:00
# NIGHTLY_REVIEW_TIME_ZONE=Asia/Kolkata
# NIGHTLY_REVIEW_LIMIT=10
# A session is ready once it had no message for NIGHTLY_QUIET_HOURS (1 to 168), and only sessions
# active in the last NIGHTLY_PICK_WITHIN_DAYS (1 to 365) are picked. A reviewed session is picked
# again once the person typed NIGHTLY_MIN_NEW_USER_MESSAGES more messages (1 to 100).
# NIGHTLY_QUIET_HOURS=6
# NIGHTLY_PICK_WITHIN_DAYS=14
# NIGHTLY_MIN_NEW_USER_MESSAGES=3

# Learning runs (the Fixes page). The harness the sessions ran, whose code each learning is
# checked against: a GitHub repo, cloned fresh for every run, or a local checkout. Set one; with
# neither, there is no weekly run. The token is read-only: it clones a private repo, and the
# nightly pick reads pull request states with it (unset, the pick uses the 6-hour rule alone).
# LEARNINGS_HARNESS_REPO=vertexcover-io/yok
# LEARNINGS_HARNESS_GITHUB_TOKEN=
# LEARNINGS_HARNESS_PATH=
# LEARNINGS_MODEL=opus

# Logging
# trace|debug|info|warn|error|fatal|silent. Unset defaults to debug outside production, info in it.
# An invalid value warns once and falls back rather than failing the boot.
# LOG_LEVEL=

# DB
DATABASE_URL=postgres://samskara:samskara@localhost:5433/samskara

# Web SPA (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Per-worktree overrides. Written by `bun run wt:setup`; leave them out of the main checkout's
# .env, where the defaults (3000 / 8000 / the `samskara` database) are what you want.
# WT_SLUG=
# WT_PORT_OFFSET=
# PORT=
# WEB_PORT=
# API_PROXY_TARGET=
