# Web SPA (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Session search -- semantic half (D11).
# This is an HTTP contract, not a library: any provider speaking the OpenAI-shaped
# POST /v1/embeddings works by changing these values alone, with no code change.
# Leave them unset and search still works -- it degrades to keyword-only (D21).
#
# Shipped default is a LOCAL model, so no paid credential is needed:
#   ollama serve && ollama pull mxbai-embed-large
# mxbai-embed-large emits 1024 dimensions natively, matching the vector(1024) column.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=mxbai-embed-large
# Open models express the query/document asymmetry as an instruction prefix rather than
# Voyage's input_type. Required for mxbai-embed-large; omit for Voyage/OpenAI.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
#
# Hosted alternative (drop the prefix line):
#   EMBEDDING_BASE_URL=https://api.voyageai.com/v1
#   EMBEDDING_API_KEY=<voyage key>
#   EMBEDDING_MODEL=voyage-4-large
