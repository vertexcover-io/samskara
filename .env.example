# Auth / GitHub OAuth
GITHUB_CLIENT_ID=Ov23linvZE00y7VZSI4Y
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated GitHub logins that get full read/write access to every project.
SUPER_ADMIN_LOGINS=

# Logging
# trace|debug|info|warn|error|fatal|silent. Unset defaults to debug outside production, info in it.
# An invalid value warns once and falls back rather than failing the boot.
# LOG_LEVEL=

# DB
DATABASE_URL=postgres://samskara:samskara@localhost:5433/samskara

# Web SPA (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Per-worktree overrides. Written by `bun run wt:setup`; leave them out of the main checkout's
# .env, where the defaults (3000 / 8000 / the `samskara` database) are what you want.
# WT_SLUG=
# WT_PORT_OFFSET=
# PORT=
# WEB_PORT=
# API_PROXY_TARGET=
