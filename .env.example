# Auth / GitHub OAuth
GITHUB_CLIENT_ID=Ov23linvZE00y7VZSI4Y
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
JWT_SECRET=
JWT_EXPIRES_IN=7d

# DB
DATABASE_URL=postgres://samskara:samskara@localhost:5433/samskara
# Size DB_POOL_MAX from the database-wide connection budget divided by maximum app replicas,
# reserving capacity for migrations, monitoring, and operator access.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=30
# Applied through the postgres startup connection parameter; controls every app query.
DB_STATEMENT_TIMEOUT_SECONDS=30
# Safe diagnostic control; disabled unless explicitly enabled server-side.
SERVER_TIMING=false

# Web SPA (Vite)
VITE_API_BASE_URL=http://localhost:3000
